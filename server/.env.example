PORT=8787
PUBLIC_URL=https://spoken-api.hellosverre.com
CALL_PROVIDER=mock
LLM_PROVIDER=mock
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=+47xxxxxxxx
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_FALLBACK=
LLM_API_KEY=
LLM_MODEL=
LLM_PLAN_MODEL=
CALL_ALLOWLIST=
TTS_MODEL=eleven_flash_v2_5
DEFAULT_VOICE_ID=nPczCjzI2devNBz1zQrb
MOCK_SPEED=1
MAX_CALL_SEC=600
MAX_CALLS_PER_DAY=20
APPROVAL_TIMEOUT_SEC=120
SCRIBE_SILENCE_SECS=0.5
# Call language when the task doesn't decide it: en | no. A task typed in Norwegian, or one that says
# «på norsk» / «in English», picks its own; mid-call «speak English» / «snakk norsk» switches.
CALL_LANG=en
# When the reply waits for the batch STT check: numbers (default) | content | off
BATCH_HOLD=numbers
BARGE_RMS=1100
TTS_SPEED=0.88
TTS_STABILITY=0.7
DIRECTORY_OVERRIDE=
MIN_BALANCE_USD=0.3
DEMO_PASSCODE=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Vonage (production)
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_NUMBER=
TTS_MODEL=eleven_v4_turbo
SAVE_CALL_AUDIO=0
CALL_LOG=0
