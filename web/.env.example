# Leave both empty to run fully in the browser against the built-in mock call.
VITE_API_URL=
VITE_WS_URL=
# Force the in-browser mock even when the URLs are set (1 = on).
VITE_MOCK=
# "/" = same origin: use this when the Bun call server serves the built app
# (VITE_API_URL=/ bun run build, then open https://spoken-api.hellosverre.com/).
